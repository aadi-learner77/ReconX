# ReconX AI — Environment Configuration Example
# Copy to .env and replace placeholder values for local development.
# NEVER commit real secrets to git.

# Application
APP_ENV=development
APP_NAME=ReconX AI
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL in Docker Compose / Neon / Supabase)
DATABASE_URL=postgresql+psycopg://reconx:reconx_local_dev@localhost:5432/reconx

# Auth & JWT (replace JWT_SECRET with a random 32+ char secret locally)
JWT_SECRET=CHANGE_ME_LOCAL_DEV_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Storage (local disk outside public web root)
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=15

# Background Jobs (D1: DB-backed jobs table + in-process worker thread)
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3

# LLM Provider Adapter (D3: mock | gemini | groq | ollama)
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Feature Flags (P2 differentiators)
FEATURE_EVIDENCE_GRAPH=true
FEATURE_FINANCE_COPILOT=true
FEATURE_ANOMALY_ML=true
FEATURE_CASH_VIEW=true
FEATURE_REPORT_EXPORTS=true

# Demo / Seed Credentials (synthetic demo users only; set in local .env)
SEED_ORG_NAME=Acme Manufacturing India Pvt Ltd
SEED_DEFAULT_PASSWORD=CHANGE_ME_DEMO_PASS_123!

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
